# PostgreSQL connection string (e.g. from a free Neon project)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign auth JWTs - generate your own, never reuse this
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="14d"

# Set to "true" once served over HTTPS in production
COOKIE_SECURE="false"

PORT="4000"

# Origin allowed to call this API with credentials (the web app's dev/prod URL)
WEB_ORIGIN="http://localhost:5173"
